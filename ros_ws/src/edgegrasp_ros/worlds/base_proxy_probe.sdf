<?xml version="1.0"?>
<sdf version="1.9">
  <model name="edgegrasp_base_proxy_probe">
    <!-- Spawn pose is supplied explicitly by probe_base_collision.sh. -->
    <pose>0 0 0 0 0 0</pose>
    <link name="probe_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000000375</ixx>
          <iyy>0.000000375</iyy>
          <izz>0.000000375</izz>
        </inertia>
      </inertial>
      <collision name="probe_collision">
        <geometry><box><size>0.015 0.015 0.015</size></box></geometry>
      </collision>
      <sensor name="probe_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>probe_collision</collision>
          <topic>/edgegrasp/base_proxy_probe_contacts</topic>
        </contact>
      </sensor>
      <visual name="probe_visual">
        <geometry><box><size>0.015 0.015 0.015</size></box></geometry>
        <material><diffuse>0.10 0.85 0.20 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
