<?xml version="1.0"?>
<sdf version="1.9">
  <world name="edgegrasp_table_cube">
    <!-- scene_contract_sha256=3ae08c486a10127e40ffd50334e8b6224267e4f4c97aad6c6229c3f5d26d2cc0 -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="table">
      <static>true</static>
      <pose>0.5 0 0.16 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.8 0.04</size>
            </box>
          </geometry>
        </collision>
        <sensor name="table_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>collision</collision>
            <topic>/edgegrasp/table_contacts</topic>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.8 0.04</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.45 0.3 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="target_cube">
      <static>false</static>
      <pose>0.247519974969 0.121038382509 0.205 0 0 0</pose>
      <link name="target_cube_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08333333333e-05</ixx>
            <iyy>2.08333333333e-05</iyy>
            <izz>2.08333333333e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <sensor name="target_cube_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>collision</collision>
            <topic>/edgegrasp/target_cube_contacts</topic>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.85 0.12 0.08 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>100</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
