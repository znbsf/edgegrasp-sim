string stage
uint64 sequence_no
geometry_msgs/PoseStamped target_pose
string target_id
int64 source_timestamp_ns
string clock_domain
uint64 clock_epoch
string planning_group
string pipeline_id
string planner_id
float64 planning_timeout_s
float64 velocity_scaling
float64 acceleration_scaling
bool plan_only
